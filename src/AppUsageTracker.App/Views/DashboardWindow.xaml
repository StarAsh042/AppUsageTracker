<Window x:Class="AppUsageTracker.App.Views.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:AppUsageTracker.App.Controls"
        Title="软件使用时间统计"
        Width="1080" Height="760" MinWidth="920" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="False"
        ResizeMode="CanResize"
        Background="{DynamicResource PageBrush}"
        ShowInTaskbar="True"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="7" GlassFrameThickness="-1"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="MiniBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="8" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" Background="{DynamicResource TrackBrush}" CornerRadius="4" />
                            <Border x:Name="PART_Indicator" Background="{DynamicResource PrimaryBrush}"
                                    CornerRadius="4" HorizontalAlignment="Left" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StatCard" TargetType="Border" BasedOn="{StaticResource CardBorder}">
            <Setter Property="Padding" Value="18,14" />
        </Style>

        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Margin" Value="0,6,0,2" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="14,4,14,14">
        <!-- 自绘标题栏 -->
        <Grid DockPanel.Dock="Top" Height="38" Margin="0,2,0,10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="/AppUsageTracker.App;component/App.ico" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="软件使用时间统计" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="10,0,0,0" />
                <Border CornerRadius="10" Background="{DynamicResource PrimarySoftBrush}" Margin="12,0,0,0" Padding="10,3" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StateText}" FontSize="12" Foreground="{Binding StateBrush}" />
                </Border>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="OnMinimizeClick" ToolTip="最小化" />
                <Button Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="OnMaximizeClick" x:Name="MaximizeButton" ToolTip="最大化" />
                <Button Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" Click="OnHideClick" ToolTip="隐藏到托盘" />
            </StackPanel>
        </Grid>

        <!-- 工具行 -->
        <Border DockPanel.Dock="Top" Style="{StaticResource CardBorder}" Padding="14,10" Margin="0,0,0,12">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Style="{StaticResource StepperButton}" Content="◀" ToolTip="开始日期前移一天"
                            Command="{Binding ShiftDateCommand}" CommandParameter="start:-1" />
                    <TextBlock Text="{Binding RangeTitle}" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="10,0,10,0"
                               VerticalAlignment="Center" MinWidth="120" TextAlignment="Center" />
                    <Button Style="{StaticResource StepperButton}" Content="▶" ToolTip="开始日期后移一天"
                            Command="{Binding ShiftDateCommand}" CommandParameter="start:1" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource SegmentButton}" Content="今天" Command="{Binding SetRangeCommand}" CommandParameter="today" />
                    <Button Style="{StaticResource SegmentButton}" Content="昨天" Command="{Binding SetRangeCommand}" CommandParameter="yesterday" />
                    <Button Style="{StaticResource SegmentButton}" Content="本周" Command="{Binding SetRangeCommand}" CommandParameter="week" />
                    <Button Style="{StaticResource SegmentButton}" Content="本月" Command="{Binding SetRangeCommand}" CommandParameter="month" />
                    <Button Style="{StaticResource StepperButton}" Content="◀" ToolTip="结束日期前移一天" Margin="12,0,0,0"
                            Command="{Binding ShiftDateCommand}" CommandParameter="end:-1" />
                    <TextBlock Text="{Binding EndDate, StringFormat=至 {0:M月d日}}" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="10,0,10,0"
                               VerticalAlignment="Center" MinWidth="76" TextAlignment="Center" />
                    <Button Style="{StaticResource StepperButton}" Content="▶" ToolTip="结束日期后移一天"
                            Command="{Binding ShiftDateCommand}" CommandParameter="end:1" />
                    <Button Style="{StaticResource GhostButton}" Content="导出 CSV" Margin="12,0,0,0" Command="{Binding ExportCsvCommand}" />
                    <Button Style="{StaticResource GhostButton}" Content="刷新" Margin="8,0,0,0" Command="{Binding RefreshCommand}" />
                    <Button Style="{StaticResource GhostButton}" Content="⚙ 设置" Margin="8,0,0,0" Command="{Binding OpenSettingsCommand}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 统计卡片 -->
                <UniformGrid Columns="4" Margin="0,0,0,14">
                    <Border Style="{StaticResource StatCard}" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource MutedText}" Text="总活跃时长" />
                            <TextBlock Style="{StaticResource StatValue}" Text="{Binding TotalActiveText}" />
                            <TextBlock FontSize="11" Text="{Binding CompareText}" Foreground="{Binding CompareBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatCard}" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource MutedText}" Text="日均活跃" />
                            <TextBlock Style="{StaticResource StatValue}" Text="{Binding DailyAverageText}" />
                            <TextBlock FontSize="11" Text="{Binding RangeTitle, StringFormat=统计范围：{0}}" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatCard}" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource MutedText}" Text="最常用分类" />
                            <TextBlock Style="{StaticResource StatValue}" Text="{Binding TopCategoryText}" />
                            <TextBlock FontSize="11" Text="按活跃时长统计" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource MutedText}" Text="使用软件数" />
                            <TextBlock Style="{StaticResource StatValue}" Text="{Binding AppCountText}" />
                            <TextBlock FontSize="11" ToolTip="{Binding TopAppText}">
                                <Run Text="最常用：" Foreground="{DynamicResource TextSecondaryBrush}" /><Run Text="{Binding TopAppText, Mode=OneWay}" Foreground="{DynamicResource PrimaryBrush}" />
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- 排行 + 分类占比（固定高度：DataGrid 内部滚动，右侧环形图保持可见） -->
                <Grid Height="540" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="4,10,4,10">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource H2}" Margin="14,4,14,6" Text="应用排行" />
                            <DataGrid x:Name="RankGrid" Style="{StaticResource MainGrid}" ItemsSource="{Binding Ranking}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="34" />
                                    <DataGridTemplateColumn Header="" Width="38">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Image Source="{Binding Icon}" Width="20" Height="20" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="应用" Binding="{Binding DisplayName}" Width="*" />
                                    <DataGridTemplateColumn Header="分类" Width="92">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                                    <Ellipse Width="8" Height="8" Fill="{Binding CategoryBrush}" />
                                                    <TextBlock Text="{Binding Category}" FontSize="12" Margin="6,0,0,0"
                                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="活跃时长" Binding="{Binding ActiveText}" Width="92" />
                                    <DataGridTemplateColumn Header="活跃占比" Width="150">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <ProgressBar Style="{StaticResource MiniBar}" Value="{Binding Percent}" Width="80" />
                                                    <TextBlock Text="{Binding Percent, StringFormat={}{0:0.0}%}" FontSize="11"
                                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="8,0,0,0"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>

                    <!-- 分类占比 -->
                    <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource H2}" Text="分类占比（按活跃时长）" Margin="0,0,0,8" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <controls:DonutChart x:Name="DonutChartControl" Width="150" Height="150" VerticalAlignment="Center"
                                                     Segments="{Binding DonutSegments}" CenterText="{Binding TotalActiveText}" />
                                <ItemsControl Grid.Column="1" ItemsSource="{Binding Categories}" Margin="14,0,0,0"
                                              VerticalAlignment="Center">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                                <Ellipse Width="9" Height="9" Fill="{Binding Brush}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Name}" FontSize="12" Margin="8,0,0,0" Width="52"
                                                           Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding DurationText}" FontSize="12" Margin="6,0,0,0" Width="70"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Right" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding PercentText}" FontSize="12" Margin="8,0,0,0" Width="44"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Right" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </DockPanel>
                    </Border>
                </Grid>

                <!-- 单日时间线 -->
                <Border Style="{StaticResource CardBorder}" Padding="16,12" Margin="0,0,0,14">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <TextBlock Style="{StaticResource H2}" Text="当日时间线" DockPanel.Dock="Left" />
                            <TextBlock Style="{StaticResource MutedText}" Text="{Binding TimelineHint}" DockPanel.Dock="Right"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </DockPanel>
                        <controls:TimelineView Height="64" Segments="{Binding TimelineSegments}" />
                    </DockPanel>
                </Border>

                <!-- 14 天趋势 -->
                <Border Style="{StaticResource CardBorder}" Padding="16,12">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource H2}" Text="近 14 天每日活跃趋势" Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding Trend}" Height="160">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Bottom" ToolTip="{Binding Tooltip}">
                                        <Rectangle Fill="{Binding BarBrush}" Height="{Binding BarHeight, Mode=OneWay}"
                                                   RadiusX="3" RadiusY="3" Margin="3,0,3,0" />
                                        <TextBlock Text="{Binding Label}" FontSize="10" HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
