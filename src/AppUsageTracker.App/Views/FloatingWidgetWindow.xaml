<Window x:Class="AppUsageTracker.App.Views.FloatingWidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="使用时长悬浮窗"
        Width="236" Height="96"
        WindowStyle="None" AllowsTransparency="False"
        ResizeMode="NoResize"
        Background="{DynamicResource WidgetBrush}"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        MouseLeftButtonDown="OnDragMove">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="-1"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <!-- 窗口本体即磨砂面板：底色半透明铺满整窗，圆角交给 DWM，无任何描边 -->
    <Grid Margin="16,10,16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Image Source="/AppUsageTracker.App;component/App.ico" Width="22" Height="22"
                   RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="今日活跃" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBlock x:Name="TotalText" Text="--" FontSize="19" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,1,0,0" />
            </StackPanel>
            <TextBlock x:Name="LiveDot" Text="●" FontSize="8" Margin="10,2,0,0"
                       Foreground="{DynamicResource OkBrush}" VerticalAlignment="Top" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
            <TextBlock x:Name="CurrentAppText" Text="等待前台应用…" FontSize="11"
                       Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"
                       MaxWidth="150" VerticalAlignment="Center" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
            <TextBlock x:Name="CurrentAppSeconds" Text="" FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryBrush}" Margin="6,0,0,0" VerticalAlignment="Center"
                       ToolTip="该应用今日累计活跃时长" />
        </StackPanel>
    </Grid>
</Window>
