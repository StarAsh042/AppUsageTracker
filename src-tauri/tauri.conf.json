{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "AppUsageTracker",
  "version": "0.7.0",
  "identifier": "com.starash042.app-usage-tracker",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "软件使用时间统计",
        "width": 1080,
        "height": 760,
        "minWidth": 920,
        "minHeight": 580,
        "center": true,
        "visible": false,
        "theme": "Dark",
        "transparent": true,
        "backgroundColor": "#00000000",
        "noRedirectionBitmap": true
      },
      {
        "label": "widget",
        "create": false,
        "url": "widget.html",
        "title": "使用时长悬浮窗",
        "width": 300,
        "height": 216,
        "x": 12,
        "y": 12,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "shadow": false,
        "focus": false,
        "skipTaskbar": true,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; font-src 'self'; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk1OTM4RjhCQjQ5MzcxNTcKUldSWGNaTzBpNCtUbFJwMlFlZ2tibWxJYXdldjNiZ3dMSWFYQjJNUDNLSitsWXBZeHE0YnVwemIK",
      "endpoints": ["https://github.com/StarAsh042/AppUsageTracker/releases/latest/download/latest.json"]
    }
  }
}
